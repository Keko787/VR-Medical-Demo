  m_Name: 
  m_EditorClassIdentifier: 
  m_DisplayName: Inner hair cells
  m_Region: "Cochlear duct \xB7 Section A"
  m_Description: "One row of about 3,500 flask-shaped cells \u2014 the real sensors.
    When their stereocilia bend, ion channels open, the cell depolarises and releases
    transmitter onto the fibres of the cochlear nerve. Nine in ten of those fibres
    come from here."
  m_Group: 1
  m_Tier: 0
  m_HasViewYaw: 0
