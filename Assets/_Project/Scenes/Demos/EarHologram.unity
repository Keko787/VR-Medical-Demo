MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1960629049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 199e38a86dd898d43871f1baff068049, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_DisplayName: Cochlea
  m_Region: "Inner ear \xB7 Hearing"
  m_Description: "The organ of hearing: a fluid-filled spiral of about two and a
    half turns, the size of a pea. Sound sends a travelling wave along the basilar
    membrane inside it. High pitches peak near the base and low pitches near the
    apex, so every place along the spiral hears its own frequency \u2014 a piano
    keyboard, rolled up."
  m_Group: 0
  m_Tier: 0
  m_HasViewYaw: 1
  m_ViewYaw: -28
  m_Pickable: 1
  m_Anchor: {x: 7.4281015, y: -3.7795677, z: -4.0938654}
  m_ExplodeOffset: {x: 10.200001, y: -1.7, z: -5.1000004}
  m_FocusCentre: {x: 6.6724863, y: -0.5268357, z: -3.0246427}
  m_FocusRadius: 6.0990934
  m_EndFade: {x: -2, y: -1, z: 2, w: 3}
  m_LandmarkNames:
  - "Base \xB7 high pitch (20 kHz)"
  - "Apex \xB7 low pitch (20 Hz)"
  - "Section A \xB7 2 kHz place"
  m_LandmarkPoints:
  - {x: 5.213194, y: -0.017421098, z: -0.42812937}
  - {x: 6.223826, y: -2.0309024, z: -6.300233}
  - {x: 7.936626, y: -3.1233864, z: -3.9431484}
