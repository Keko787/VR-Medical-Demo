  m_Name: 
  m_EditorClassIdentifier: 
  m_DisplayName: Stapes (stirrup)
  m_Region: "Middle ear \xB7 Ossicle"
  m_Description: "The smallest bone in the body, about 3 mm tall. Its footplate fills
    the oval window and pistons into the inner ear. Funnelling the eardrum's ~55
    mm\xB2 onto this ~3 mm\xB2 plate is most of the middle ear's ~20\xD7 pressure
    gain \u2014 without it, 99.9% of sound would bounce off the fluid of the inner
    ear."
  m_Group: 0
  m_Tier: 1
  m_HasViewYaw: 1
  m_ViewYaw: -40
  m_Pickable: 1
