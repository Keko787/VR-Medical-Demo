  m_PlayTone: 1
  m_Volume: 0.12
  m_Steps:
  - Text: The auricle funnels sound down the ear canal
    Parts:
    - {fileID: 146805844}
    - {fileID: 335267971}
  - Text: The eardrum vibrates with it
    Parts:
    - {fileID: 1273034319}
  - Text: "The ossicles lever it inward, about 20\xD7 stronger"
    Parts:
    - {fileID: 446122308}
    - {fileID: 708730809}
    - {fileID: 1775132121}
  - Text: The stapes pumps the oval window; the round window gives
    Parts:
    - {fileID: 1775132121}
    - {fileID: 2073047235}
    - {fileID: 1141487214}
  - Text: A travelling wave peaks at the place for its pitch
    Parts:
    - {fileID: 1960629054}
    - {fileID: 126657094}
    - {fileID: 1578017262}
  - Text: Hair cells there fire the cochlear nerve to the brain
    Parts:
    - {fileID: 1297856952}
    - {fileID: 46018773}
    - {fileID: 330486211}
    - {fileID: 1370632208}
    - {fileID: 367347827}
  m_StepSeconds: 3.6
