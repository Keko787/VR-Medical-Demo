  m_Name: 
  m_EditorClassIdentifier: 
  m_DisplayName: Auricle (pinna)
  m_Region: Outer ear
  m_Description: 'The visible ear: a single plate of elastic cartilage under skin,
    folded into ridges and hollows. It gathers sound into the canal, and because
    its folds colour a sound differently depending on where it comes from, it is
    how you tell above from below and front from back.'
  m_Group: 0
  m_Tier: 0
  m_HasViewYaw: 1
