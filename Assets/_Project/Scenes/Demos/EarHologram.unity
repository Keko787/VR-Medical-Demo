  m_Name: 
  m_EditorClassIdentifier: 
  m_DisplayName: Scala media (cochlear duct)
  m_Region: "Cochlear duct \xB7 Section A"
  m_Description: 'The middle chamber, filled with endolymph: rich in potassium and
    held at +80 mV by the stria vascularis. That charge is the battery the hair cells
    run on. The organ of Corti sits on its floor.'
