  m_Name: 
  m_EditorClassIdentifier: 
  m_DisplayName: Anterior semicircular canal
  m_Region: "Inner ear \xB7 Balance"
  m_Description: "One of three fluid-filled loops set at right angles. Also called
    the superior canal, it senses rotation in its own plane \u2014 chiefly nodding.
    When the head turns, the fluid lags behind, bending the gel cupula in the canal's
    swollen ampulla and the hair cells beneath it."
  m_Group: 0
  m_Tier: 1
  m_HasViewYaw: 1
  m_ViewYaw: 50
